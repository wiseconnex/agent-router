{"openapi":"3.1.0","info":{"title":"systemone-router","version":"4.0.0"},"paths":{"/health":{"get":{"summary":"Health","operationId":"health_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/v1/models":{"get":{"summary":"List Models","operationId":"list_models_v1_models_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/tools":{"get":{"summary":"List Tools","operationId":"list_tools_tools_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/pool":{"get":{"summary":"Pool State","description":"Adaptive agent pool state.\n\nBy default returns a small snapshot. Append `?metrics=1` for the full\npicture (size, busy/free, queue depth, spawn count, P50/P99 latency,\nuptime, scaling parameters).","operationId":"pool_state_pool_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/pool/metrics":{"get":{"summary":"Pool Metrics","description":"Full adaptive-pool metrics: P50/P99 latency, queue depth, scale history.\n\nUse this for dashboards / Prometheus scrapes. The plain `/pool` endpoint\nis cheaper if you only need current size.","operationId":"pool_metrics_pool_metrics_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/v1/diagnostics":{"get":{"summary":"Diagnostics","description":"Full operational diagnostics — pool state, frontier in-flight, feedback DB.\n\nAdded in response to Diana's Hallazgo 2 (intermittent timeouts under low\nload). Use this to attribute stuck workers, see what the loop is doing,\nand check if SQLite writes are getting stuck.","operationId":"diagnostics_v1_diagnostics_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/v1/reset-feedback":{"post":{"summary":"Reset Feedback","description":"Reset feedback DB records (Diana's v3 Hallazgo 3 — recovery from stuck state).\n\nQuery params:\n  task: optional. If given, only reset that task's records.\n        If absent, reset ALL tasks.\n\nReturns: {\"deleted\": <count>}\n\nThis is the operational recovery for when the feedback DB accumulates\nenough attempts that the short-circuit kicks in for a brief, but the\nsystem is hung on a different brief that should also be unsolvable.\nResetting the feedback lets the next call retry from scratch.","operationId":"reset_feedback_v1_reset_feedback_post","parameters":[{"name":"task","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Task"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/v1/confidence-threshold":{"get":{"summary":"Confidence Threshold","description":"Return the default confidence thresholds used by the routing pattern.\n\nClients can either:\n1. Pass `routing` per request (highest priority), or\n2. Use these defaults when no `routing` is sent.\n\nThreshold recommendations by use case (per cactus blog):\n  - light switch / read-only: act=0.5\n  - default: act=0.7, confirm=0.3\n  - money / message send: act=0.9\n\nTo change the defaults for this deployment, set the env vars\nSYSTEMONE_ROUTER_DEFAULT_ACT_THRESHOLD and SYSTEMONE_ROUTER_DEFAULT_CONFIRM_THRESHOLD.","operationId":"confidence_threshold_v1_confidence_threshold_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/v1/verbalize-models":{"get":{"summary":"Verbalize Models","description":"Return the catalog of models available for `verbalize=true` requests.\n\nClients can pass `verbalize_model` (one of these IDs) in chat completions.\nDefault is `qwen3.5:9b`. Use this endpoint to discover what's available\nwithout reading the source code.\n\nAll models are local via oMLX on this host. None require cloud calls.","operationId":"verbalize_models_v1_verbalize_models_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/v1/chat/completions":{"post":{"summary":"Chat Completions","operationId":"chat_completions_v1_chat_completions_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChatCompletionRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}}},"components":{"schemas":{"ChatCompletionRequest":{"properties":{"model":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Model"},"messages":{"items":{"$ref":"#/components/schemas/ChatMessage"},"type":"array","title":"Messages"},"temperature":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Temperature","default":1.0},"top_p":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Top P","default":1.0},"max_tokens":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Max Tokens","default":512},"stream":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Stream","default":false},"tools":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"title":"Tools"},"tool_choice":{"anyOf":[{"type":"string"},{"additionalProperties":true,"type":"object"},{"type":"null"}],"title":"Tool Choice"},"routing":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"title":"Routing"},"verbalize":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Verbalize","default":false},"verbalize_model":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Verbalize Model","default":"qwen3.5:9b"}},"type":"object","required":["messages"],"title":"ChatCompletionRequest"},"ChatMessage":{"properties":{"role":{"type":"string","title":"Role"},"content":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Content"},"name":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Name"},"tool_calls":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"title":"Tool Calls"},"tool_call_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Tool Call Id"}},"type":"object","required":["role"],"title":"ChatMessage"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"},"input":{"title":"Input"},"ctx":{"type":"object","title":"Context"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}}}